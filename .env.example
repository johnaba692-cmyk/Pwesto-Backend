# Copy this file to .env and update the values below

# Application Settings
APP_KEY=
APP_ENV=development
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
PWESTO_DB_PATH=
PWESTO_ADMIN_EMAILS=
PWESTO_MONTHLY_RENT_PHP=7000
PWESTO_APP_URL=
PWESTO_MEAT_VENDOR_EMAIL=
PWESTO_FRUIT_VENDOR_EMAIL=
# Gmail SMTP credentials (use a Google App Password, not your account password)
PWESTO_MAIL_HOST=smtp.gmail.com
PWESTO_MAIL_PORT=587
PWESTO_MAIL_USERNAME=
PWESTO_MAIL_PASSWORD=
# Optional; defaults to PWESTO_MAIL_USERNAME
PWESTO_MAIL_FROM=
PWESTO_MAIL_FROM_NAME=Pwesto

# Cloudinary (server-side credentials; vendor application files use authenticated delivery)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Use the test/development key while validating checkout; do not expose these values to the frontend.
XENDIT_MODE=test
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=
PWESTO_DB_DRIVER=sqlite
PWESTO_DB_SSL_CA=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=
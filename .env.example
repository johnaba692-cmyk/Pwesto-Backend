# Copy this file to .env and fill in the values. .env is ignored by Git.

# Application
APP_KEY=
APP_ENV=development
PWESTO_APP_URL=http://127.0.0.1:3000
PWESTO_ADMIN_EMAILS=
PWESTO_MONTHLY_RENT_PHP=7000

# Database (read by app/config/database.php)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4
DB_PREFIX=
# CA certificate for remote MySQL (Aiven). Leave blank to use app/config/aiven-ca.pem.
PWESTO_DB_SSL_CA=

# LavaLust Api library (app/config/api.php) - two different random values, 32+ characters each
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Google sign-in
GOOGLE_CLIENT_ID=

# Gemini shopping assistant
GEMINI_API_KEY=

# Gmail SMTP (use a Google App Password, not your account password)
PWESTO_MAIL_HOST=smtp.gmail.com
PWESTO_MAIL_PORT=587
PWESTO_MAIL_USERNAME=
PWESTO_MAIL_PASSWORD=
# Optional; defaults to PWESTO_MAIL_USERNAME
PWESTO_MAIL_FROM=
PWESTO_MAIL_FROM_NAME=Pwesto

# Cloudinary (server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Xendit GCash checkout (use test keys while developing)
XENDIT_MODE=test
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
